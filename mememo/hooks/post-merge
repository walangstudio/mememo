#!/usr/bin/env bash
# mememo post-merge git hook (T013 / FR-010, FR-033).
#
# After a git merge completes, fold the source branch's alive memories into
# the now-current branch via `mememo merge-branch`. Opt-in: installed only
# by `mememo install-git-hooks`.
#
# git invokes this hook with no arguments. The merged-from ref is recorded
# in .git/ORIG_HEAD; the now-current branch is HEAD. We resolve the source
# branch via `git name-rev` and fall back gracefully if it's a detached ref.

set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
TARGET_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
ORIG_HEAD="$(cat "$REPO_ROOT/.git/ORIG_HEAD" 2>/dev/null || true)"

# Reject anything that isn't a well-formed 40-char SHA — defends against
# someone writing garbage (or a leading dash) into .git/ORIG_HEAD before
# the hook fires.
if ! printf '%s' "$ORIG_HEAD" | grep -Eq '^[0-9a-fA-F]{40}$'; then
  exit 0
fi

SOURCE_BRANCH="$(git name-rev --name-only --no-undefined "$ORIG_HEAD" 2>/dev/null || true)"
if [ -z "$SOURCE_BRANCH" ] || [ "$SOURCE_BRANCH" = "$TARGET_BRANCH" ]; then
  exit 0
fi

# Strip refs/heads/ or remotes/origin/ prefixes name-rev sometimes emits.
SOURCE_BRANCH="${SOURCE_BRANCH#refs/heads/}"
SOURCE_BRANCH="${SOURCE_BRANCH#remotes/origin/}"

# Whitelist the post-stripping branch name; reject anything exotic that
# might confuse a downstream consumer.
if ! printf '%s' "$SOURCE_BRANCH" | grep -Eq '^[A-Za-z0-9_/.-]+$'; then
  exit 0
fi

if ! command -v mememo >/dev/null 2>&1; then
  exit 0
fi

mememo merge-branch \
  --repo-path "$REPO_ROOT" \
  --source "$SOURCE_BRANCH" \
  --target "$TARGET_BRANCH" \
  >/dev/null 2>&1 || true
